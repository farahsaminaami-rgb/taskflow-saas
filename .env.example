# ---------------------------------------------------------------------------
# TaskFlow environment — copy this to `.env` and fill in real values.
# Supabase connection strings look like:
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# ---------------------------------------------------------------------------

# Postgres connection string (Supabase / Neon / local).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/taskflow?schema=public"

# Used only by `prisma migrate dev` to create an isolated shadow DB.
SHADOW_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/taskflow_shadow?schema=public"

# Next.js
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# NextAuth.js (Auth.js v5) — use `npx auth secret` to generate.
AUTH_SECRET=""

# Database session secret for Credentials provider cookie encoding.
AUTH_URL="http://localhost:3000"

# OAuth providers (leave empty to disable).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Stripe (billing). Test keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Supabase keys — required only if you opt into the Supabase Realtime bridge
# instead of the built-in SSE engine.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""